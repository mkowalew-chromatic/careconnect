{
  "name": "@careconnect/portal-mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "storybook": "cross-env EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start --clear",
    "storybook:ios": "cross-env EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start --clear --ios",
    "storybook:android": "cross-env EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start --clear --android",
    "build": "expo export --platform ios --platform android --output-dir dist",
    "typecheck": "tsc --noEmit",
    "chromatic": "chromatic --exit-zero-on-changes"
  },
  "dependencies": {
    "@careconnect/api-client": "*",
    "@careconnect/design-system-native": "*",
    "@careconnect/types": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@gorhom/bottom-sheet": "^5.2.6",
    "@storybook/addon-ondevice-actions": "10.5.1",
    "@storybook/react-native": "10.5.1",
    "@types/react": "^19.2.18",
    "chromatic": "^18.12.0",
    "cross-env": "^10.1.0",
    "storybook": "^10.6.0",
    "typescript": "^5.9.3"
  }
}
