# CareConnect deployment configuration
# Copy to /etc/careconnect/careconnect.env and customize before install.

# Primary domain or IP (path mode: use VM IP e.g. 192.168.11.8, or se-tools.net)
DOMAIN="192.168.11.8"

# Deployment layout:
#   path      — port 80: / (portal), /ehr/
#   subdomain — portal.{DOMAIN}, ehr.{DOMAIN}
#   ports     — custom ports 8080/8081
DEPLOY_MODE="path"

# Subdomain prefixes (subdomain mode only)
PORTAL_HOST="portal"
EHR_HOST="ehr"

# URL path prefixes (path mode only; must start and end with /)
PORTAL_BASE_PATH="/"
EHR_BASE_PATH="/ehr/"

# HTTP ports (subdomain mode: usually 80 for all; ports mode: 8080/8081/8082)
PORTAL_PORT=80
EHR_PORT=80

# API runtime (systemd uses /etc/careconnect/careconnect-api.env)
API_PORT=5000
CARECONNECT_DATA_DIR="/var/lib/careconnect"
# JWT_SECRET — auto-generated on first install if unset

# Install locations
INSTALL_DIR="/opt/careconnect"
WWW_ROOT="/var/www/careconnect"
CONFIG_DIR="/etc/careconnect"

# Linux user that owns the application files
APP_USER="careconnect"

# Enable Let's Encrypt HTTPS (requires DNS pointing to this VM)
ENABLE_SSL="false"
SSL_EMAIL="admin@se-tools.net"

# Node.js major version
NODE_MAJOR=22
