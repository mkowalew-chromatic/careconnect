# CareConnect deployment configuration
#
# Copy to deploy/<environment>.env (gitignored) and customize. The installer
# copies it to /etc/careconnect/careconnect.env on the VM. Keep real hostnames,
# addresses, and usernames out of the committed repo.

# Primary domain or IP: the VM address for path mode (e.g. 192.0.2.10), or the
# bare domain for subdomain mode (e.g. example.com)
DOMAIN="192.0.2.10"

# Deployment layout:
#   path      — port 80: / (portal), /ehr/
#   subdomain — portal.{DOMAIN}, ehr.{DOMAIN}
#   ports     — custom ports 8080/8081
DEPLOY_MODE="path"

# Subdomain prefixes (subdomain mode only)
PORTAL_HOST="portal"
EHR_HOST="ehr"

# URL path prefixes (path mode only; must start and end with /)
PORTAL_BASE_PATH="/"
EHR_BASE_PATH="/ehr/"

# HTTP ports (subdomain mode: usually 80 for all; ports mode: 8080/8081/8082)
PORTAL_PORT=80
EHR_PORT=80

# API runtime (systemd uses /etc/careconnect/careconnect-api.env)
API_PORT=5000
CARECONNECT_DATA_DIR="/var/lib/careconnect"
# JWT_SECRET — auto-generated on first install if unset

# Install locations
INSTALL_DIR="/opt/careconnect"
WWW_ROOT="/var/www/careconnect"
CONFIG_DIR="/etc/careconnect"

# Linux user that owns the application files
APP_USER="careconnect"

# Past releases kept per unit for rollback (frontend release dirs, API
# artifacts, DB backups)
RELEASE_RETENTION=5

# Enable Let's Encrypt HTTPS (requires DNS pointing to this VM)
ENABLE_SSL="false"
SSL_EMAIL="admin@example.com"

# Node.js major version
NODE_MAJOR=22

# SSH target for deploy/remote-install.sh and deploy/setup-ssh-key.sh, run from
# your laptop. Values exported in the environment take precedence over these.
# (Ignored by the installer on the VM itself.)
VM_USER="ubuntu"
VM_HOST="192.0.2.10"
# VM_PORT=22
# SSH_KEY="$HOME/.ssh/id_ed25519"
