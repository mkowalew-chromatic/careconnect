{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "tsconfig.base.json",
    "scripts/vite-chart-manual-chunks.ts",
    ".nvmrc"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "@careconnect/design-system#test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "test-results/**",
        "coverage/**"
      ]
    },
    "test:stories": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "test-results/**"
      ]
    },
    "build-storybook": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "storybook-static/**"
      ]
    }
  }
}
